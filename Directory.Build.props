<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <!-- Win32 version resource. A blank publisher and product make an unsigned build look
       worse than it is to SmartScreen and to antivirus heuristics. -->
  <PropertyGroup>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <Product>TeraLink</Product>
    <Company>zhuyihenzheng</Company>
    <Authors>zhuyihenzheng</Authors>
    <Copyright>Copyright (c) 2026 zhuyihenzheng</Copyright>
  </PropertyGroup>
</Project>
